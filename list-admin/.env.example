# App metadata
# Values are quoted so this file is safe for both python-dotenv and shell sourcing.
APP_VERSION="v1.2.0"
APP_AUTHOR="Henri Muldre"

# Database
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="mailing_list"
DB_USER="mailing_list_user"
DB_PASS="change-me"

# Security
FLASK_SECRET="replace-with-a-random-string-at-least-32-characters-long"
# Shared mail credential encryption key for both services.
# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAIL_CREDENTIALS_KEY=""

# Admin UI runtime
LIST_ADMIN_HOST="127.0.0.1"
LIST_ADMIN_PORT=9010
DEFAULT_IMAP_FOLDER="INBOX"
# I18N_DIR="i18n"

# Optional session fallbacks
# IDLE_TIMEOUT_SECONDS=1800
# ABSOLUTE_TIMEOUT_SECONDS=43200

# Optional watchdog tuning (only when using ensure-list-admin.sh, i.e. when your host has no PM2 management panel)
# STARTUP_WAIT_SECONDS=30
# HEALTH_TIMEOUT=5
# HEALTH_RETRIES=2
# HEALTH_CHECK_INTERVAL=1

# Optional logs shown on the Logs page (relative paths are resolved from list-admin/)
# MLIST_LOG_PATH="../list/logs/mlist.log"
# ENSURE_LOG_PATH="logs/ensure-list-admin.log"  # section only shown if this file exists
# PM2_OUT_LOG_PATH="/path/to/.pm2/logs/list-admin-out.log"      # default: $PM2_HOME/logs/ or ~/.pm2/logs/
# PM2_ERROR_LOG_PATH="/path/to/.pm2/logs/list-admin-error.log"
# MLIST_LOG_TAIL=400
# FLASK_DEBUG=0
# FLASK_RELOAD=0
# FLASK_DEBUGGER=0
